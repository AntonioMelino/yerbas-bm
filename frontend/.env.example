# URL base de la API del backend.
# En desarrollo local se usa la ruta relativa /api, que el dev server de Vite
# proxifica a http://localhost:5035 (ver vite.config.ts) para evitar CORS.
# En producción (Vercel) apuntar a la URL real, ej.:
# VITE_API_URL=https://yerbas-bm-api.railway.app/api
VITE_API_URL=/api

# Número de WhatsApp del negocio (testing; se cambia antes del lanzamiento).
# Lo usa la feature carrito → WhatsApp (pendiente).
VITE_WHATSAPP_NUMBER=5491151225690
